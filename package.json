{
  "name": "flavorvoyage-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests *.js *.json *.html",
    "format:check": "prettier --check src scripts tests *.js *.json *.html"
  },
  "dependencies": {
    "@firebase/app": "^0.16.5",
    "@firebase/auth": "^1.13.9",
    "@tailwindcss/vite": "^4.3.5",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.11.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "prettier": "^3.9.10",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=24"
  }
}
